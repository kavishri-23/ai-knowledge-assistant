# Copy to .env and change what you need. Every value below is the default.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
EMBEDDING_MODEL=all-MiniLM-L6-v2
DATA_DIR=data
MAX_UPLOAD_MB=20
MAX_PAGES=300
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.2
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
